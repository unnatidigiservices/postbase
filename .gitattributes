# Consistent line endings for everyone (Windows, macOS, Linux)
* text=auto eol=lf

# Binary assets — never touched
*.png binary
*.jpg binary
*.webp binary
*.gif binary
*.ico binary
*.sqlite binary

# Show PHP diffs nicely on GitHub
*.php diff=php

# Keep repo-only files out of "Download ZIP" / release archives
/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/tools export-ignore
/docs export-ignore
